# OS
.DS_Store

# Local agent/tooling config
.devx/
.mcp.json

# Multi-agent setup must live in the repo, but ~/.gitignore_global ignores **/.claude/.
# Re-include the shared config (agents + permissions); keep local-only overrides out.
!.claude/
.claude/settings.local.json

# Python bytecode
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Secrets / local env (Railway injects real env vars at runtime)
.env
.env.*
!.env.example

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editor
.vscode/
.idea/

# Runtime logs/data (forwarder LOG_DIR, if ever pointed at a local path)
data/
*.log
