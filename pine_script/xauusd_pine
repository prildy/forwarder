//@version=6
indicator("XAUUSD Multi-Indicator → JSON Webhook", shorttitle = "XAU JSON", overlay = true, max_bars_back = 500)

// ═══════════════════════════════════════════════════════════
// GENERAL
// ═══════════════════════════════════════════════════════════
grpG = "General"
secret   = input.string("", "Webhook secret", group = grpG)
sendMode = input.string("Any signal", "Kirim alert saat", options = ["Any signal", "Every bar close"], group = grpG)
atrLen   = input.int(14, "ATR length", minval = 1, group = grpG)
SCHEMA   = "2.0"
PD       = 3   // desimal harga XAUUSD

// ═══════════════════════════════════════════════════════════
// JSON HELPERS  (na → null supaya JSON tetap valid)
// ═══════════════════════════════════════════════════════════
fNum(float x, int dec) =>
    na(x) ? "null" : str.tostring(math.round(x, dec))

fStr(string s) =>
    "\"" + s + "\""

fBool(bool b) =>
    b ? "true" : "false"

fKV(string k, string v) =>
    "\"" + k + "\":" + v

fObj(array<string> kv) =>
    "{" + array.join(kv, ",") + "}"

fArr(array<string> items) =>
    "[" + array.join(items, ",") + "]"

atr = ta.atr(atrLen)

// ═══════════════════════════════════════════════════════════
// 1. BBMA (Bollinger Bands + MA5/10 High-Low + EMA50)
// ═══════════════════════════════════════════════════════════
grpB = "BBMA"
bbLen  = input.int(20, "BB length", minval = 1, group = grpB)
bbMult = input.float(2.0, "BB multiplier", step = 0.1, group = grpB)

[bbMid, bbUp, bbLo] = ta.bb(close, bbLen, bbMult)
ma5H  = ta.wma(high, 5)
ma10H = ta.wma(high, 10)
ma5L  = ta.wma(low, 5)
ma10L = ta.wma(low, 10)
ema50 = ta.ema(close, 50)

bbWidthPct  = bbMid != 0 ? (bbUp - bbLo) / bbMid * 100 : na
bbPos       = close > bbUp ? "above_upper" : close >= bbMid ? "upper_half" : close >= bbLo ? "lower_half" : "below_lower"
bbmaTrend   = close > ema50 and bbMid > bbMid[1] ? "up" : close < ema50 and bbMid < bbMid[1] ? "down" : "sideways"
extremeSell = ma5H > bbUp or ma10H > bbUp
extremeBuy  = ma5L < bbLo or ma10L < bbLo
csmBuy      = close > bbUp and close[1] <= bbUp[1]
csmSell     = close < bbLo and close[1] >= bbLo[1]
reentryBuy  = bbmaTrend == "up" and low <= math.max(ma5L, ma10L) and close > math.min(ma5L, ma10L) and close > bbMid
reentrySell = bbmaTrend == "down" and high >= math.min(ma5H, ma10H) and close < math.max(ma5H, ma10H) and close < bbMid

// ═══════════════════════════════════════════════════════════
// 2. ICHIMOKU
// ═══════════════════════════════════════════════════════════
grpI = "Ichimoku"
ichiConv = input.int(9,  "Tenkan",       minval = 1, group = grpI)
ichiBase = input.int(26, "Kijun",        minval = 1, group = grpI)
ichiSpB  = input.int(52, "Senkou B",     minval = 1, group = grpI)
ichiDisp = input.int(26, "Displacement", minval = 2, group = grpI)

donchian(int len) =>
    math.avg(ta.lowest(len), ta.highest(len))

tenkan   = donchian(ichiConv)
kijun    = donchian(ichiBase)
spanANow = math.avg(tenkan, kijun)
spanBNow = donchian(ichiSpB)
disp     = ichiDisp - 1
cloudA   = spanANow[disp]
cloudB   = spanBNow[disp]
cloudTop = math.max(cloudA, cloudB)
cloudBot = math.min(cloudA, cloudB)

priceVsCloud = na(cloudTop) ? "unknown" : close > cloudTop ? "above" : close < cloudBot ? "below" : "inside"
futureCloud  = spanANow > spanBNow ? "bullish" : spanANow < spanBNow ? "bearish" : "neutral"
tkUp         = ta.crossover(tenkan, kijun)
tkDn         = ta.crossunder(tenkan, kijun)
tkCross      = tkUp ? "bullish" : tkDn ? "bearish" : "none"
chikouPos    = close > high[disp] ? "above_price" : close < low[disp] ? "below_price" : "inside_price"

// ═══════════════════════════════════════════════════════════
// 3. LIQUIDITY POOLS (konsep: level swing yang belum di-sweep)
// ═══════════════════════════════════════════════════════════
grpL = "Liquidity Pools"
liqLen    = input.int(10, "Pivot length", minval = 2, group = grpL)
liqMax    = input.int(20, "Max level tersimpan", minval = 2, group = grpL)
liqTolAtr = input.float(0.15, "Toleransi equal level (×ATR)", minval = 0, step = 0.05, group = grpL)

liqPH = ta.pivothigh(high, liqLen, liqLen)
liqPL = ta.pivotlow(low, liqLen, liqLen)

var array<float> bsl = array.new<float>()   // buy-side liquidity (di atas swing high)
var array<float> ssl = array.new<float>()   // sell-side liquidity (di bawah swing low)

if not na(liqPH)
    array.push(bsl, liqPH)
    if array.size(bsl) > liqMax
        array.shift(bsl)
if not na(liqPL)
    array.push(ssl, liqPL)
    if array.size(ssl) > liqMax
        array.shift(ssl)

// Sweep = wick menembus level lalu close kembali (liquidity grab)
// Taken = close menembus level (breakout)
bool  bslSwept    = false
bool  bslTaken    = false
float bslSweptLvl = na
if array.size(bsl) > 0
    for i = array.size(bsl) - 1 to 0
        lvl = array.get(bsl, i)
        if high > lvl
            if close < lvl
                bslSwept    := true
                bslSweptLvl := na(bslSweptLvl) ? lvl : math.max(bslSweptLvl, lvl)
            else
                bslTaken := true
            array.remove(bsl, i)

bool  sslSwept    = false
bool  sslTaken    = false
float sslSweptLvl = na
if array.size(ssl) > 0
    for i = array.size(ssl) - 1 to 0
        lvl = array.get(ssl, i)
        if low < lvl
            if close > lvl
                sslSwept    := true
                sslSweptLvl := na(sslSweptLvl) ? lvl : math.min(sslSweptLvl, lvl)
            else
                sslTaken := true
            array.remove(ssl, i)

fNearestAbove(array<float> arr, float px) =>
    float best = na
    for lvl in arr
        if lvl > px and (na(best) or lvl < best)
            best := lvl
    best

fNearestBelow(array<float> arr, float px) =>
    float best = na
    for lvl in arr
        if lvl < px and (na(best) or lvl > best)
            best := lvl
    best

fCountNear(array<float> arr, float ref, float tol) =>
    int n = 0
    if not na(ref)
        for lvl in arr
            if math.abs(lvl - ref) <= tol
                n += 1
    n

liqTol    = liqTolAtr * atr
bslNear   = fNearestAbove(bsl, close)
sslNear   = fNearestBelow(ssl, close)
bslPool   = fCountNear(bsl, bslNear, liqTol)
sslPool   = fCountNear(ssl, sslNear, liqTol)

// ═══════════════════════════════════════════════════════════
// 4. VOLUME WEIGHTED TREND (VWMA + ATR band)
// ═══════════════════════════════════════════════════════════
grpV = "Volume Weighted Trend"
vwLen  = input.int(20, "VWMA length", minval = 1, group = grpV)
vwMult = input.float(1.0, "ATR band multiplier", minval = 0, step = 0.1, group = grpV)

vwmaRaw = ta.vwma(close, vwLen)
smaFb   = ta.sma(close, vwLen)
vwBase  = na(vwmaRaw) ? smaFb : vwmaRaw   // fallback jika feed tanpa volume
vwUp    = vwBase + vwMult * atr
vwDn    = vwBase - vwMult * atr

var int vwTrend = 0
if close > vwUp
    vwTrend := 1
else if close < vwDn
    vwTrend := -1
vwChanged = vwTrend != 0 and vwTrend != nz(vwTrend[1])
vwBars    = ta.barssince(vwChanged)
vwTrendS  = vwTrend == 1 ? "bullish" : vwTrend == -1 ? "bearish" : "undefined"

// ═══════════════════════════════════════════════════════════
// 5. SMART MONEY CONCEPTS (BOS/CHoCH, Order Block, FVG, P/D)
// ═══════════════════════════════════════════════════════════
grpS = "Smart Money Concepts"
smcLen    = input.int(10, "Swing length", minval = 2, group = grpS)
fvgMinAtr = input.float(0.0, "FVG min size (×ATR)", minval = 0, step = 0.05, group = grpS)

sPH = ta.pivothigh(high, smcLen, smcLen)
sPL = ta.pivotlow(low, smcLen, smcLen)

var float swHi        = na
var int   swHiBar     = na
var bool  swHiBroken  = true
var float swLo        = na
var int   swLoBar     = na
var bool  swLoBroken  = true
var int   structTrend = 0

if not na(sPH)
    swHi       := sPH
    swHiBar    := bar_index - smcLen
    swHiBroken := false
if not na(sPL)
    swLo       := sPL
    swLoBar    := bar_index - smcLen
    swLoBroken := false

var float bullObTop = na
var float bullObBot = na
var bool  bullObMit = false
var float bearObTop = na
var float bearObBot = na
var bool  bearObMit = false

bool bosBull   = false
bool chochBull = false
bool bosBear   = false
bool chochBear = false

// Break ke atas swing high
if not swHiBroken and close > swHi
    if structTrend == -1
        chochBull := true
    else
        bosBull := true
    structTrend := 1
    swHiBroken  := true
    int lb = math.min(bar_index - swHiBar, 300)
    if lb >= 1
        float mn  = low
        int   idx = 0
        for i = 1 to lb
            if low[i] < mn
                mn  := low[i]
                idx := i
        bullObTop := high[idx]
        bullObBot := low[idx]
        bullObMit := false

// Break ke bawah swing low
if not swLoBroken and close < swLo
    if structTrend == 1
        chochBear := true
    else
        bosBear := true
    structTrend := -1
    swLoBroken  := true
    int lb = math.min(bar_index - swLoBar, 300)
    if lb >= 1
        float mx  = high
        int   idx = 0
        for i = 1 to lb
            if high[i] > mx
                mx  := high[i]
                idx := i
        bearObTop := high[idx]
        bearObBot := low[idx]
        bearObMit := false

if not na(bullObBot) and not bullObMit and close < bullObBot
    bullObMit := true
if not na(bearObTop) and not bearObMit and close > bearObTop
    bearObMit := true
inBullOb = not bullObMit and low <= bullObTop and high >= bullObBot
inBearOb = not bearObMit and high >= bearObBot and low <= bearObTop

// Fair Value Gap
fvgBull = low > high[2] and close[1] > high[2] and (low - high[2]) >= fvgMinAtr * atr
fvgBear = high < low[2] and close[1] < low[2] and (low[2] - high) >= fvgMinAtr * atr

var float bFvgTop    = na
var float bFvgBot    = na
var bool  bFvgFilled = false
var float sFvgTop    = na
var float sFvgBot    = na
var bool  sFvgFilled = false

if fvgBull
    bFvgTop    := low
    bFvgBot    := high[2]
    bFvgFilled := false
else if not na(bFvgBot) and not bFvgFilled and low <= bFvgBot
    bFvgFilled := true

if fvgBear
    sFvgTop    := low[2]
    sFvgBot    := high
    sFvgFilled := false
else if not na(sFvgTop) and not sFvgFilled and high >= sFvgTop
    sFvgFilled := true

// Premium / Discount berdasarkan swing terakhir
pdRange = swHi - swLo
eqLvl   = math.avg(swHi, swLo)
pdZone  = na(pdRange) or pdRange <= 0 ? "unknown" : close > eqLvl + 0.05 * pdRange ? "premium" : close < eqLvl - 0.05 * pdRange ? "discount" : "equilibrium"

structTrendS = structTrend == 1 ? "bullish" : structTrend == -1 ? "bearish" : "undefined"
structEvent  = chochBull ? "choch_bullish" : bosBull ? "bos_bullish" : chochBear ? "choch_bearish" : bosBear ? "bos_bearish" : "none"

// ═══════════════════════════════════════════════════════════
// 6. ADX & DI
// ═══════════════════════════════════════════════════════════
grpA = "ADX & DI"
adxLen = input.int(14, "Length", minval = 1, group = grpA)
adxTh  = input.float(20, "Threshold", group = grpA)

[diP, diM, adx] = ta.dmi(adxLen, adxLen)
diBullX  = ta.crossover(diP, diM)
diBearX  = ta.crossunder(diP, diM)
diCross  = diBullX ? "bullish" : diBearX ? "bearish" : "none"
adxState = adx >= adxTh ? "trending" : "ranging"
adxSlope = adx > adx[1] ? "rising" : "falling"
diDir    = diP > diM ? "bullish" : diP < diM ? "bearish" : "neutral"

// ═══════════════════════════════════════════════════════════
// 7. STOCHASTIC RSI
// ═══════════════════════════════════════════════════════════
grpR = "Stoch RSI"
srRsiLen = input.int(14, "RSI length",   minval = 1, group = grpR)
srStLen  = input.int(14, "Stoch length", minval = 1, group = grpR)
srK      = input.int(3,  "K smoothing",  minval = 1, group = grpR)
srD      = input.int(3,  "D smoothing",  minval = 1, group = grpR)
stOB     = input.float(80, "Overbought", group = grpR)
stOS     = input.float(20, "Oversold",   group = grpR)

srRsi   = ta.rsi(close, srRsiLen)
stK     = ta.sma(ta.stoch(srRsi, srRsi, srRsi, srStLen), srK)
stD     = ta.sma(stK, srD)
stBullX = ta.crossover(stK, stD)
stBearX = ta.crossunder(stK, stD)
stZone  = stK > stOB ? "overbought" : stK < stOS ? "oversold" : "neutral"
stCross = stBullX ? "bullish" : stBearX ? "bearish" : "none"

// ═══════════════════════════════════════════════════════════
// 8. MACD + DIVERGENCES (regular & hidden)
// ═══════════════════════════════════════════════════════════
grpM = "MACD Divergences"
mFast    = input.int(12, "Fast",   minval = 1, group = grpM)
mSlow    = input.int(26, "Slow",   minval = 1, group = grpM)
mSig     = input.int(9,  "Signal", minval = 1, group = grpM)
divL     = input.int(5,  "Pivot left",  minval = 1, group = grpM)
divR     = input.int(5,  "Pivot right", minval = 1, group = grpM)
rangeMin = input.int(5,  "Min bars antar pivot", minval = 1, group = grpM)
rangeMax = input.int(60, "Max bars antar pivot", minval = 2, group = grpM)

[macdLine, sigLine, macdHist] = ta.macd(close, mFast, mSlow, mSig)
macdBullX = ta.crossover(macdLine, sigLine)
macdBearX = ta.crossunder(macdLine, sigLine)

mPL = ta.pivotlow(macdLine, divL, divR)
mPH = ta.pivothigh(macdLine, divL, divR)
plF = not na(mPL)
phF = not na(mPH)

prevMacdPL = ta.valuewhen(plF, macdLine[divR], 1)
prevLowPL  = ta.valuewhen(plF, low[divR], 1)
prevBarPL  = ta.valuewhen(plF, bar_index, 1)
prevMacdPH = ta.valuewhen(phF, macdLine[divR], 1)
prevHighPH = ta.valuewhen(phF, high[divR], 1)
prevBarPH  = ta.valuewhen(phF, bar_index, 1)

gapL     = bar_index - prevBarPL
gapH     = bar_index - prevBarPH
inRangeL = gapL >= rangeMin and gapL <= rangeMax
inRangeH = gapH >= rangeMin and gapH <= rangeMax

regBull = plF and inRangeL and low[divR]  < prevLowPL  and macdLine[divR] > prevMacdPL
hidBull = plF and inRangeL and low[divR]  > prevLowPL  and macdLine[divR] < prevMacdPL
regBear = phF and inRangeH and high[divR] > prevHighPH and macdLine[divR] < prevMacdPH
hidBear = phF and inRangeH and high[divR] < prevHighPH and macdLine[divR] > prevMacdPH

divEvent = regBull ? "regular_bullish" : hidBull ? "hidden_bullish" : regBear ? "regular_bearish" : hidBear ? "hidden_bearish" : "none"

var string lastDiv    = "none"
var int    lastDivBar = na
if divEvent != "none"
    lastDiv    := divEvent
    lastDivBar := bar_index - divR
lastDivAgo = bar_index - lastDivBar

// ═══════════════════════════════════════════════════════════
// TRIGGERS
// ═══════════════════════════════════════════════════════════
triggers = array.new<string>()
if bosBull
    array.push(triggers, fStr("smc_bos_bullish"))
if chochBull
    array.push(triggers, fStr("smc_choch_bullish"))
if bosBear
    array.push(triggers, fStr("smc_bos_bearish"))
if chochBear
    array.push(triggers, fStr("smc_choch_bearish"))
if fvgBull
    array.push(triggers, fStr("smc_fvg_bullish"))
if fvgBear
    array.push(triggers, fStr("smc_fvg_bearish"))
if bslSwept
    array.push(triggers, fStr("liq_bsl_sweep"))
if sslSwept
    array.push(triggers, fStr("liq_ssl_sweep"))
if extremeBuy and not extremeBuy[1]
    array.push(triggers, fStr("bbma_extreme_buy"))
if extremeSell and not extremeSell[1]
    array.push(triggers, fStr("bbma_extreme_sell"))
if csmBuy
    array.push(triggers, fStr("bbma_csm_buy"))
if csmSell
    array.push(triggers, fStr("bbma_csm_sell"))
if reentryBuy and not reentryBuy[1]
    array.push(triggers, fStr("bbma_reentry_buy"))
if reentrySell and not reentrySell[1]
    array.push(triggers, fStr("bbma_reentry_sell"))
if tkUp
    array.push(triggers, fStr("ichi_tk_cross_bullish"))
if tkDn
    array.push(triggers, fStr("ichi_tk_cross_bearish"))
if vwChanged
    array.push(triggers, fStr(vwTrend == 1 ? "vwt_flip_bullish" : "vwt_flip_bearish"))
if diBullX
    array.push(triggers, fStr("di_cross_bullish"))
if diBearX
    array.push(triggers, fStr("di_cross_bearish"))
if stBullX and math.min(stK, stD) < stOS
    array.push(triggers, fStr("stochrsi_bull_cross_oversold"))
if stBearX and math.max(stK, stD) > stOB
    array.push(triggers, fStr("stochrsi_bear_cross_overbought"))
if divEvent != "none"
    array.push(triggers, fStr("macd_div_" + divEvent))

// ═══════════════════════════════════════════════════════════
// BUILD JSON
// ═══════════════════════════════════════════════════════════
eventId = syminfo.tickerid + "|" + timeframe.period + "|" + str.tostring(time)

candleJson = fObj(array.from(
     fKV("open",   fNum(open,  PD)),
     fKV("high",   fNum(high,  PD)),
     fKV("low",    fNum(low,   PD)),
     fKV("close",  fNum(close, PD)),
     fKV("volume", fNum(volume, 2)),
     fKV("volume_type", fStr(syminfo.volumetype)),
     fKV("atr",    fNum(atr, PD)),
     fKV("atr_len", str.tostring(atrLen))))

bbmaJson = fObj(array.from(
     fKV("trend",        fStr(bbmaTrend)),
     fKV("bb_upper",     fNum(bbUp,  PD)),
     fKV("bb_mid",       fNum(bbMid, PD)),
     fKV("bb_lower",     fNum(bbLo,  PD)),
     fKV("bb_width_pct", fNum(bbWidthPct, 3)),
     fKV("ma5_high",     fNum(ma5H,  PD)),
     fKV("ma10_high",    fNum(ma10H, PD)),
     fKV("ma5_low",      fNum(ma5L,  PD)),
     fKV("ma10_low",     fNum(ma10L, PD)),
     fKV("ema50",        fNum(ema50, PD)),
     fKV("price_position", fStr(bbPos)),
     fKV("extreme_buy",  fBool(extremeBuy)),
     fKV("extreme_sell", fBool(extremeSell)),
     fKV("csm_buy",      fBool(csmBuy)),
     fKV("csm_sell",     fBool(csmSell)),
     fKV("reentry_buy",  fBool(reentryBuy)),
     fKV("reentry_sell", fBool(reentrySell))))

ichiJson = fObj(array.from(
     fKV("tenkan",         fNum(tenkan,   PD)),
     fKV("kijun",          fNum(kijun,    PD)),
     fKV("cloud_top",      fNum(cloudTop, PD)),
     fKV("cloud_bottom",   fNum(cloudBot, PD)),
     fKV("price_vs_cloud", fStr(priceVsCloud)),
     fKV("future_cloud",   fStr(futureCloud)),
     fKV("tk_cross",       fStr(tkCross)),
     fKV("chikou",         fStr(chikouPos))))

liqJson = fObj(array.from(
     fKV("bsl_nearest",     fNum(bslNear, PD)),
     fKV("bsl_dist_atr",    fNum((bslNear - close) / atr, 2)),
     fKV("bsl_pool_size",   str.tostring(bslPool)),
     fKV("ssl_nearest",     fNum(sslNear, PD)),
     fKV("ssl_dist_atr",    fNum((close - sslNear) / atr, 2)),
     fKV("ssl_pool_size",   str.tostring(sslPool)),
     fKV("bsl_swept",       fBool(bslSwept)),
     fKV("bsl_swept_level", fNum(bslSweptLvl, PD)),
     fKV("bsl_taken",       fBool(bslTaken)),
     fKV("ssl_swept",       fBool(sslSwept)),
     fKV("ssl_swept_level", fNum(sslSweptLvl, PD)),
     fKV("ssl_taken",       fBool(sslTaken)),
     fKV("active_bsl",      str.tostring(array.size(bsl))),
     fKV("active_ssl",      str.tostring(array.size(ssl)))))

vwJson = fObj(array.from(
     fKV("trend",         fStr(vwTrendS)),
     fKV("basis",         fNum(vwBase, PD)),
     fKV("upper",         fNum(vwUp,   PD)),
     fKV("lower",         fNum(vwDn,   PD)),
     fKV("flipped",       fBool(vwChanged)),
     fKV("bars_in_trend", na(vwBars) ? "null" : str.tostring(vwBars))))

smcJson = fObj(array.from(
     fKV("structure_trend",  fStr(structTrendS)),
     fKV("structure_event",  fStr(structEvent)),
     fKV("swing_high",       fNum(swHi, PD)),
     fKV("swing_low",        fNum(swLo, PD)),
     fKV("pd_zone",          fStr(pdZone)),
     fKV("equilibrium",      fNum(eqLvl, PD)),
     fKV("bull_ob_top",      fNum(bullObTop, PD)),
     fKV("bull_ob_bottom",   fNum(bullObBot, PD)),
     fKV("bull_ob_mitigated", fBool(bullObMit)),
     fKV("in_bull_ob",       fBool(inBullOb)),
     fKV("bear_ob_top",      fNum(bearObTop, PD)),
